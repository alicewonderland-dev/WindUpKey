<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dalamud-free tests for the plugin's relay identity, sync, unpair-queue, wire-limit and self-test code, and the rules
    behind issue 06's review fixes. Not part of the plugin build or its packaging:
    nothing references this project, and deploy/Pack-Plugin.ps1 builds only WindUpKey/WindUpKey.csproj.
    Run with: dotnet test WindUpKey.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Program.cs is also the second process for the cross-process lock test, so the test SDK's empty one is off. -->
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- 04-D1: the self-test units are compiled into the plugin only under WINDUP_TESTING; here they always are. -->
    <DefineConstants>$(DefineConstants);WINDUP_SELFTEST_UNITS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin's Dalamud-free sources, compiled in directly: the plugin project itself needs Dalamud. -->
    <Compile Include="..\WindUpKey\Services\RelayIdentityStore.cs" Link="Plugin\RelayIdentityStore.cs" />
    <Compile Include="..\WindUpKey\Services\RelayConnectPolicy.cs" Link="Plugin\RelayConnectPolicy.cs" />
    <Compile Include="..\WindUpKey\Services\RelaySyncRules.cs" Link="Plugin\RelaySyncRules.cs" />
    <Compile Include="..\WindUpKey\Services\PairRemovalQueue.cs" Link="Plugin\PairRemovalQueue.cs" />
    <Compile Include="..\WindUpKey\PendingPairRemoval.cs" Link="Plugin\PendingPairRemoval.cs" />
    <Compile Include="..\WindUpKey\PairedPartner.cs" Link="Plugin\PairedPartner.cs" />
    <Compile Include="..\WindUpKey\OwnedDoll.cs" Link="Plugin\OwnedDoll.cs" />
    <Compile Include="..\WindUpKey\PairingKeyUtil.cs" Link="Plugin\PairingKeyUtil.cs" />
    <Compile Include="..\WindUpKey\RemoteText.cs" Link="Plugin\RemoteText.cs" />
    <Compile Include="..\WindUpKey\LogRedact.cs" Link="Plugin\LogRedact.cs" />
    <Compile Include="..\WindUpKey\Services\RelayWireRules.cs" Link="Plugin\RelayWireRules.cs" />
    <!-- 06 Part A: the profile, and the Dalamud-free rules of the review fixes. -->
    <Compile Include="..\WindUpKey\CharacterProfile.cs" Link="Plugin\CharacterProfile.cs" />
    <Compile Include="..\WindUpKey\PlayerRole.cs" Link="Plugin\PlayerRole.cs" />
    <Compile Include="..\WindUpKey\ProfileMigration.cs" Link="Plugin\ProfileMigration.cs" />
    <Compile Include="..\WindUpKey\Ui\LockEmoteDisplay.cs" Link="Plugin\LockEmoteDisplay.cs" />
    <Compile Include="..\WindUpKey\Ui\CharacterBoundConfirm.cs" Link="Plugin\CharacterBoundConfirm.cs" />
    <Compile Include="..\WindUpKey\Services\LowWindProfileGuard.cs" Link="Plugin\LowWindProfileGuard.cs" />
    <Compile Include="..\WindUpKey\Services\MoodlesSyncGate.cs" Link="Plugin\MoodlesSyncGate.cs" />
    <Compile Include="..\WindUpKey\Services\SafewordText.cs" Link="Plugin\SafewordText.cs" />
    <Compile Include="..\WindUpKey\Services\ClipLedger.cs" Link="Plugin\ClipLedger.cs" />
    <Compile Include="..\WindUpKey\Services\WindMath.cs" Link="Plugin\WindMath.cs" />
    <Compile Include="..\WindUpKey\Services\LoginSitRule.cs" Link="Plugin\LoginSitRule.cs" />
    <Compile Include="..\WindUpKey\Sources\CommendationTracker.cs" Link="Plugin\CommendationTracker.cs" />
    <!-- The self-test's Dalamud-free units (04 Architecture); its thin adapters (SelfTestHost, SelfTestController) need Dalamud. -->
    <Compile Include="..\WindUpKey\SelfTest\*.cs" LinkBase="Plugin\SelfTest" />
    <ProjectReference Include="..\WindUpKey.Protocol\WindUpKey.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
