<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dalamud-free tests for the plugin's relay identity code. Not part of the plugin build or its packaging:
    nothing references this project, and deploy/Pack-Plugin.ps1 builds only WindUpKey/WindUpKey.csproj.
    Run with: dotnet test WindUpKey.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Program.cs is also the second process for the cross-process lock test, so the test SDK's empty one is off. -->
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin's Dalamud-free sources, compiled in directly: the plugin project itself needs Dalamud. -->
    <Compile Include="..\WindUpKey\Services\RelayIdentityStore.cs" Link="Plugin\RelayIdentityStore.cs" />
    <Compile Include="..\WindUpKey\Services\RelayConnectPolicy.cs" Link="Plugin\RelayConnectPolicy.cs" />
    <Compile Include="..\WindUpKey\PairingKeyUtil.cs" Link="Plugin\PairingKeyUtil.cs" />
    <ProjectReference Include="..\WindUpKey.Protocol\WindUpKey.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
